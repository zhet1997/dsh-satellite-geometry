# Copy to .env only when overriding the local defaults.
SATCAD_BIND_ADDRESS=127.0.0.1
SATCAD_PORT=8787
SATCAD_TOKEN=
# A timed-out or skipped exact check is reported as unknown, never passed.
SATCAD_PAIR_TIMEOUT_SECONDS=10
SATCAD_CHECK_BUDGET_SECONDS=300
SATCAD_MAX_EXACT_PAIRS=1500
SATCAD_JOB_TIMEOUT_SECONDS=3600
